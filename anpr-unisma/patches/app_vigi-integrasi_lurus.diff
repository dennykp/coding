 # ======================================================================
+# PELURUSAN PLAT (sidecar /baca)
+# ======================================================================
+# Kamera gerbang melihat plat dari atas-samping sehingga plat di gambar
+# terputar tajam (72% kotak plat berasio < 1,8; plat mendatar ~3:1).
+# Sidecar memutar area plat ke 13 sudut (-54..+54), mendeteksi ulang plat di tiap
+# sudut, membaca, lalu mem-voting. Penjelasan & angka uji lengkap ada di
+# fpo_service.py -> baca_lurus().
+#
+# Uji silang-kamera 01-10-2026 (230 penilaian): benar 74,8% -> 82,2%.
+# Dengan ambang dashboard 0,80, plat SALAH yang tampil turun 17,8% -> 6,3%.
+# Saat bacaan lama dan bacaan lurus berselisih: lurus benar 14x, lama 1x.
+#
+# Matikan dengan FPO_LURUS=0 di .env -> perilaku persis seperti sebelumnya.
+FPO_LURUS = _os.environ.get("FPO_LURUS", "1").strip().lower() \
+    not in ("0", "false", "no", "off")
+FPO_LURUS_URL = f"http://{_FPO_HOST}:8011/baca"
+FPO_LURUS_TIMEOUT = float(_os.environ.get("FPO_LURUS_TIMEOUT", "8"))
+
+
+def _fpo_lurus(frame_bgr: np.ndarray, det_box: list):
+    """
+    Minta sidecar meluruskan dan membaca plat di det_box.
+
+    Return:
+      dict  -> sidecar menjawab. dict["plate"] bisa KOSONG: artinya di 13
+               sudut tidak ada satu pun bacaan berbentuk plat sah.
+      None  -> sidecar tidak terjangkau/galat. Pemanggil harus kembali ke
+               jalur lama apa adanya (aman bila sidecar mati).
+    """
+    try:
+        ih, iw = frame_bgr.shape[:2]
+        x1, y1, x2, y2 = [float(v) for v in det_box]
+        bw, bh = x2 - x1, y2 - y1
+        if bw <= 2 or bh <= 2:
+            return None
+        cx, cy = (x1 + x2) / 2.0, (y1 + y2) / 2.0
+        R = max(bw, bh) * 1.35
+        X1, Y1 = int(max(0, cx - R)), int(max(0, cy - R))
+        X2, Y2 = int(min(iw, cx + R)), int(min(ih, cy + R))
+        area = frame_bgr[Y1:Y2, X1:X2]
+        if area.size == 0:
+            return None
+        ok, buf = cv2.imencode(".jpg", area, [cv2.IMWRITE_JPEG_QUALITY, 95])
+        if not ok:
+            return None
+        q = (f"?x1={x1 - X1:.1f}&y1={y1 - Y1:.1f}"
+             f"&x2={x2 - X1:.1f}&y2={y2 - Y1:.1f}")
+        req = _urlrequest.Request(
+            FPO_LURUS_URL + q, data=buf.tobytes(),
+            headers={"Content-Type": "application/octet-stream"},
+            method="POST",
+        )
+        with _urlrequest.urlopen(req, timeout=FPO_LURUS_TIMEOUT) as resp:
+            d = _json.loads(resp.read().decode())
+        return d if isinstance(d, dict) else None
+    except Exception as e:
+        log.debug(f"[LURUS] sidecar tidak tersedia: {e}")
+        return None
+
+
