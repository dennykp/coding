# Konfigurasi SIMPERA v2 di server program-unggulan.
# Salin jadi /var/www/html/simpera-v2/backend/.env lalu chmod 600.
#
# Catatan penting: config.py punya fallback yang membaca .env Laravel di
# path SERVER LAMA (/home/esurat193/...). Path itu tidak ada di server baru,
# jadi seluruh nilai DB WAJIB diisi eksplisit di sini.

APP_NAME="SIMPERA v2"
BASE_PATH=/simpera-v2

# --- Database ---
# Sama dengan yang dipakai e-surat di server baru. Kedua aplikasi memang
# berbagi satu database (tt_suratmasuk, tt_disposisi, users, arteri_*).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=esurat
DB_USER=esurat
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DB

# --- JWT ---
# Salin nilai JWT_SECRET dari server lama kalau ingin sesi pengguna yang
# sedang berjalan tetap sah. Kalau diganti, semua pengguna harus login ulang.
# JANGAN biarkan kosong: fallback-nya memakai APP_KEY Laravel, dan APP_KEY di
# server baru sudah diregenerasi sehingga berbeda dari server lama.
JWT_SECRET=GANTI_DENGAN_SECRET_DARI_SERVER_LAMA
JWT_EXPIRE_MINUTES=720

# --- Jaringan ---
BIND_HOST=127.0.0.1
BIND_PORT=8123

# --- Berkas lampiran ---
# Menunjuk ke folder e-surat di server baru, supaya lampiran yang diunggah
# lewat SIMPERA tetap bisa dibuka dari aplikasi Laravel dan sebaliknya.
FILE_BASE_URL=https://program-unggulan.unisma.ac.id/esurat/public
UPLOAD_ROOT=/var/www/html/esurat/public

# Batas unggah di sisi aplikasi. Harus <= client_max_body_size nginx (32M).
MAX_UPLOAD_MB=25
